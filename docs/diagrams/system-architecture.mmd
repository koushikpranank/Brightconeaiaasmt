flowchart TD
    subgraph Sources["Data sources"]
        SUP[Supplier API - simulated]
        INV[Inventory API - simulated]
        LOG[Logistics API - simulated]
        WX[Weather API - real, Open-Meteo]
    end

    subgraph Backend["FastAPI backend"]
        SCHED[Scheduler - 60s sweep]
