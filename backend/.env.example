# Database. Defaults to a local SQLite file if unset - swap for a real Postgres URL in staging/prod.
DATABASE_URL=sqlite:///./supply_chain.db
# postgresql+psycopg2://user:password@localhost:5432/supply_chain

# LLM provider used only to phrase explanations/recommendations in natural language.
# All numeric calculations (inventory, stockout dates, comparisons) are deterministic Python
# and never depend on the LLM. Set LLM_PROVIDER=mock to run with zero external calls/keys.
LLM_PROVIDER=mock
# LLM_PROVIDER=openai | anthropic | gemini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Inventory shortage threshold (fraction of required quantity), used by the detection agent.
LOW_INVENTORY_THRESHOLD_DAYS=10

# A supplier whose quoted lead time grows this much past its on-file baseline (30% = 0.3)
# is flagged as an "unusual lead-time increase" disruption, even with no active delay yet.
LEAD_TIME_INCREASE_THRESHOLD=0.3

# Email notifications: log-only by default (prints/stores instead of sending) so the demo
# never sends real email without explicit SMTP configuration.
EMAIL_MODE=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_RECIPIENT=supply.manager@example.com

# Real external integration used to demonstrate genuine tool-calling (no API key required).
WEATHER_API_BASE=https://api.open-meteo.com/v1/forecast

# Monitoring scheduler interval (seconds)
MONITOR_INTERVAL_SECONDS=60
